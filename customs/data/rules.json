    {
      "rule_id": "R008",
      "rule_name": "9610 退运免税时效",
      "description": "9610 退运商品自出口之日起6个月内原状退运免进口税费",
      "business_type": [
        "退运处理",
        "时效监控",
        "F节点监控"
      ],
      "condition": {
        "cargo_contains": "退运"
      },
      "exceptions": [
        {
          "field": "cargo",
          "op": "contains",
          "value": "食品",
          "reason": "食品不适用退运免税，见R010"
        }
      ],
      "missing_data_action": "ask_user",
      "risk": "9610/1210/9710/9810 项下出口商品因滞销/退货原因，自出口之日起 6 个月内原状退运进境的（不含食品），免征进口关税和进口环节增值税、消费税；出口时已征的出口关税准予退还",
      "advice": "核实出口日期是否在 6 个月内；准备出口申报清单/报关单 + 退运原因说明材料（滞销→自我声明，退货→退货记录/退货协议）；已退税的需补缴后凭《出口货物已补税/未退税证明》办理免税",
      "severity": "critical",
      "source_document_id": "ANN-16-2026-RETURN",
      "source_article": "第一条、第三条",
      "policy_source": "财政部 海关总署 税务总局公告 2026年第16号",
      "policy_validity": {
        "valid_from": "2026-01-01",
        "valid_to": "2027-12-31",
        "status": "active"
      },
      "review_status": "verified",
      "reviewer": "C板块原文核对",
      "last_reviewed": "2026-10-31",
      "status": "active"
    },
